# vec-embed.service — OPTIONAL persistent embedding daemon
#
# ============================================================
# THIS SERVICE IS COMPLETELY OPTIONAL. DO NOT AUTO-ENABLE IT.
# ============================================================
#
# PURPOSE
# -------
# vec compiles the ONNX model graph from scratch on every invocation.
# On large models this takes a few seconds. If that startup lag bothers
# you for interactive use, this daemon solves it: it loads the model
# once at startup and keeps the compiled graph in RAM indefinitely.
# `vec <query>` then tries /run/vec/embed.sock first (near-instant)
# and silently falls back to in-process loading if the socket is absent.
#
# MEMORY COST
# -----------
# The daemon holds the compiled ONNX model in resident memory at all times.
# Typical footprint: 150–300 MB depending on model size.
# THIS IS PERMANENT RAM USAGE for the lifetime of the service.
#
# WHEN TO ENABLE
# --------------
# Only enable this service if BOTH conditions are true:
#   1. You run `vec <query>` interactively many times a day AND
#   2. You have RAM to spare (the system has enough free memory that
#      150–300 MB of permanent resident usage is acceptable)
#
# WHEN NOT TO ENABLE
# ------------------
#   - Servers or containers with tight memory budgets
#   - Systems where `vec` is used only occasionally
#   - Any situation where 150–300 MB of permanent RAM is not worth
#     saving a few seconds of startup time per query
#
# vec works correctly without this service. The only difference is
# a few seconds of startup latency on each `vec <query>` invocation.
#
# SOCKET ACTIVATION
# -----------------
# This service is started by vec-embed.socket on the first query. Set
# [daemon] idle_exit_secs in /etc/vec.conf to have it exit when idle, which
# frees the memory until the next query: the RAM cost then only applies
# while vec is in use. The query that starts the daemon waits for the model
# to load and be hashed, bounded by [daemon] reply_timeout_ms (raise it on a
# slow machine).
#
# HOW TO ENABLE (user's explicit choice only)
# -------------------------------------------
#   systemctl enable --now vec-embed.socket
#
# HOW TO DISABLE
# --------------
#   systemctl disable --now vec-embed.socket vec-embed.service
#
# SANDBOX
# -------
# The daemon runs as a transient unprivileged user (DynamicUser=) with a
# read-only system and no network: the ONNX backend needs neither. It reads
# /etc/vec.conf and the model under /usr/share/vec/models (both world-
# readable). For [embed] backend = "ollama" the daemon needs the network:
#   systemctl edit vec-embed.service
#   [Service]
#   PrivateNetwork=no
#   RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
#
# Packagers: DO NOT enable this in postinst. Ship it disabled.

[Unit]
Description=vec embedding daemon (OPTIONAL — see comments before enabling)
Documentation=https://github.com/kvzp/vec/blob/main/CONFIG.md#daemon
Requires=vec-embed.socket
After=vec-embed.socket

[Service]
Type=simple
ExecStart=/usr/bin/vec daemon
Restart=on-failure
RestartSec=30s

# Low scheduling priority — this is a background helper.
Nice=19
IOSchedulingClass=idle

# Sandbox (see above).
DynamicUser=yes
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
# Started through the socket; enabling the service enables the socket.
Also=vec-embed.socket
