# vec-watch.service (userland) — real-time index updates
#
# Reload the configuration without losing pending changes:
#   systemctl --user reload vec-watch.service

[Unit]
Description=vec real-time semantic index watcher (userland)
# Restart if it crashes; inotify errors are transient
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=%h/.local/bin/vec --config %h/.config/vec/config.toml watch
ExecReload=/bin/kill -HUP $MAINPID
Nice=19
IOSchedulingClass=idle
Restart=on-failure
RestartSec=5s
# Give inotify enough room for large trees
LimitNOFILE=65536

# Sandbox options that work in a user manager (seccomp, no namespaces:
# ProtectSystem=, PrivateNetwork= etc. need unprivileged user namespaces,
# which some distributions disable).
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
