[Unit]
Description=vec semantic index update (userland)

[Service]
Type=oneshot
ExecStart=%h/.local/bin/vec --config %h/.config/vec/config.toml updatedb
ExecStartPost=%h/.local/bin/vec --config %h/.config/vec/config.toml gc
Nice=19
IOSchedulingClass=idle
# Allow enough time for full home directory indexing
TimeoutStartSec=1h

# Sandbox options that work in a user manager (seccomp, no namespaces:
# ProtectSystem=, PrivateNetwork= etc. need unprivileged user namespaces,
# which some distributions disable).
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
