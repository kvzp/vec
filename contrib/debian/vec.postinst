#!/bin/sh
set -e

case "$1" in
    configure)
        # Apply the inotify limit immediately (also takes effect at next boot).
        sysctl --system >/dev/null 2>&1 || true
        # vec-updatedb.timer and vec-watch.service are enabled and started by
        # dh_installsystemd (#DEBHELPER# below); vec-embed.* stay disabled.
        ;;
esac

#DEBHELPER#
exit 0
